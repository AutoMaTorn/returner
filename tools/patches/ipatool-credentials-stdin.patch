@@ -0,0 +1,39 @@
+package cmd
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestReadStdinCredentials(t *testing.T) {
+	got, err := readStdinCredentials(strings.NewReader(
+		`{"keychain-passphrase":"k","password":"p w\"d","auth-code":"123456"}` + "\r\n" + "ignored",
+	))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if got.KeychainPassphrase != "k" || got.Password != `p w"d` || got.AuthCode != "123456" {
+		t.Fatalf("unexpected credentials: %+v", got)
+	}
+}
+
+func TestReadStdinCredentialsWithoutNewline(t *testing.T) {
+	got, err := readStdinCredentials(strings.NewReader(`{"keychain-passphrase":"k"}`))
+	if err != nil || got.KeychainPassphrase != "k" || got.Password != "" {
+		t.Fatalf("unexpected result: %+v, %v", got, err)
+	}
+}
+
+func TestReadStdinCredentialsRejectsBadInput(t *testing.T) {
+	for _, input := range []string{"", "\n", "secret-not-json\n"} {
+		_, err := readStdinCredentials(strings.NewReader(input))
+		if err == nil {
+			t.Fatalf("expected an error for %q", input)
+		}
+
+		if strings.Contains(err.Error(), "secret") {
+			t.Fatalf("error leaks input: %v", err)
+		}
+	}
+}
diff --git a/cmd/prepare.go b/cmd/prepare.go
new file mode 100644
index 0000000..83ce40f
--- /dev/null
+++ b/cmd/prepare.go
@@ -0,0 +1,126 @@
+package cmd
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/majd/ipatool/v2/internal/sap/assets"
+	"github.com/majd/ipatool/v2/internal/sap/unicorn"
+	"github.com/spf13/cobra"
+)
+
+// prepareStep is one component a first sign-in would otherwise download.
+type prepareStep struct {
+	name   string
+	cached func() bool
+	load   func(context.Context) error
+	// size is about how many bytes load fetches; it only feeds the progress
+	// estimate.
+	size func() int64
+}
+
+// appleAssetsDownloadSize is what loading the pinned assets read over the
+// network in a run with an empty cache (measured 2026-11-12).
+const appleAssetsDownloadSize = 311_632_823
+
+var prepareSteps = []prepareStep{
+	{name: "runtime", cached: unicorn.Cached, load: unicorn.Prepare, size: unicorn.DownloadSize},
+	{name: "apple-assets", cached: assets.Cached, load: func(ctx context.Context) error {
+		_, err := assets.Load(ctx)
+
+		return err //nolint:wrapcheck
+	}, size: func() int64 { return appleAssetsDownloadSize }},
+}
+
+// progressInterval is how often a running download reports its bytes.
+const progressInterval = time.Second
+
+// reportProgress prints the bytes received so far for all steps of this run
+// against the expected total until stop is closed.
+func reportProgress(stage string, received func() int64, total int64, stop <-chan struct{}, done chan<- struct{}) {
+	defer close(done)
+
+	ticker := time.NewTicker(progressInterval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-stop:
+			return
+		case <-ticker.C:
+			dependencies.Logger.Log().Str("stage", stage).Str("state", "progress").
+				Int64("bytes", received()).Int64("total", total).Send()
+		}
+	}
+}
+
+// nolint:wrapcheck
+func prepareCmd() *cobra.Command {
+	var check bool
+
+	cmd := &cobra.Command{
+		Use:   "prepare",
+		Short: "Download the components a first sign-in needs into the user cache",
+		Long: "Downloads the Unicorn runtime and the pinned Apple assets that sign-in and downloads use, " +
+			"one step at a time, and reports each step. With --check nothing is downloaded.",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			ready := true
+			missing := make([]prepareStep, 0, len(prepareSteps))
+
+			for _, step := range prepareSteps {
+				if step.cached() {
+					dependencies.Logger.Log().Str("stage", step.name).Str("state", "cached").Send()
+
+					continue
+				}
+
+				if check {
+					ready = false
+
+					dependencies.Logger.Log().Str("stage", step.name).Str("state", "missing").Send()
+
+					continue
+				}
+
+				missing = append(missing, step)
+			}
+
+			var total int64
+			for _, step := range missing {
+				total += step.size()
+			}
+
+			received, restore := countDefaultTransport()
+			defer restore()
+
+			for _, step := range missing {
+				dependencies.Logger.Log().Str("stage", step.name).Str("state", "downloading").
+					Int64("bytes", received.Load()).Int64("total", total).Send()
+
+				stop, stopped := make(chan struct{}), make(chan struct{})
+				go reportProgress(step.name, received.Load, total, stop, stopped)
+
+				err := step.load(cmd.Context())
+
+				close(stop)
+				<-stopped
+
+				if err != nil {
+					return fmt.Errorf("prepare %s: %w", step.name, err)
+				}
+
+				dependencies.Logger.Log().Str("stage", step.name).Str("state", "done").
+					Int64("bytes", received.Load()).Int64("total", total).Send()
+			}
+
+			dependencies.Logger.Log().Bool("ready", ready).Bool("success", true).Send()
+
+			return nil
+		},
+	}
+
+	cmd.Flags().BoolVar(&check, "check", false, "only report whether the components are cached")
+
+	return cmd
+}
