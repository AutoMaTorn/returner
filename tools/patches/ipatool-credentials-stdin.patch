+}
+
+// DownloadSize is about how many bytes Prepare fetches on this platform, or
+// zero when that is not known.
+func DownloadSize() int64 {
+	goos := runtime.GOOS
+	if goos == "linux" && linuxUsesMusl() {
+		goos = "linux-musl"
+	}
+
+	selected, err := artifactFor(goos, runtime.GOARCH)
+	if err != nil {
+		return 0
+	}
+
+	var total int64
+	for _, item := range append(append([]artifact{}, selected.dependencies...), selected) {
+		total += archiveSizes[item.archiveSHA256]
+	}
+
+	return total
+}
+
+// Prepare downloads the Unicorn runtime into the user cache unless it is
+// already there, so a later sign-in does not wait for it.
+func Prepare(ctx context.Context) error {
+	_, err := cachedRuntimePaths(ctx)
+
+	return err
+}
