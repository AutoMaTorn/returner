+package unicorn
+
+import "context"
+
+// Cached is always true on iOS: Unicorn is linked into the binary.
+func Cached() bool { return true }
+
+// Prepare has nothing to download on iOS.
+func Prepare(context.Context) error { return nil }
+
+// DownloadSize is zero on iOS: there is nothing to fetch.
+func DownloadSize() int64 { return 0 }
