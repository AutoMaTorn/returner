index 0000000..7f5f273
--- /dev/null
+++ b/cmd/prepare_progress.go
@@ -0,0 +1,47 @@
+package cmd
+
+import (
+	"io"
+	"net/http"
+	"sync/atomic"
+)
+
+// countingTransport counts the response body bytes every request through it
+// reads, so `prepare` can report how much of a download has arrived without
+// threading a callback through each component's own client.
+type countingTransport struct {
+	base  http.RoundTripper
+	bytes *atomic.Int64
+}
+
+func (t countingTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	response, err := t.base.RoundTrip(request)
+	if response != nil && response.Body != nil {
+		response.Body = countingBody{ReadCloser: response.Body, bytes: t.bytes}
+	}
+
+	return response, err //nolint:wrapcheck
+}
+
+type countingBody struct {
+	io.ReadCloser
+	bytes *atomic.Int64
+}
+
+func (b countingBody) Read(data []byte) (int, error) {
+	n, err := b.ReadCloser.Read(data)
+	b.bytes.Add(int64(n))
+
+	return n, err //nolint:wrapcheck
+}
+
+// countDefaultTransport routes the clients that leave Transport unset (all
+// of the component downloads do) through a counter, and returns it with a
+// function that restores the previous transport.
+func countDefaultTransport() (*atomic.Int64, func()) {
+	counter := &atomic.Int64{}
+	previous := http.DefaultTransport
+	http.DefaultTransport = countingTransport{base: previous, bytes: counter}
+
+	return counter, func() { http.DefaultTransport = previous }
+}
