+++ b/cmd/prepare_progress_test.go
@@ -0,0 +1,41 @@
+package cmd
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestCountDefaultTransportCountsBodiesAndRestores(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, _ *http.Request) {
+		_, _ = io.WriteString(writer, strings.Repeat("x", 1000))
+	}))
+	defer server.Close()
+
+	original := http.DefaultTransport
+	received, restore := countDefaultTransport()
+
+	// A client with no transport of its own, as the component downloads use.
+	client := &http.Client{}
+	for range 3 {
+		response, err := client.Get(server.URL)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		_, _ = io.Copy(io.Discard, response.Body)
+		_ = response.Body.Close()
+	}
+
+	if got := received.Load(); got != 3000 {
+		t.Fatalf("counted %d bytes, want 3000", got)
+	}
+
+	restore()
+
+	if http.DefaultTransport != original {
+		t.Fatal("the default transport was not restored")
+	}
+}
