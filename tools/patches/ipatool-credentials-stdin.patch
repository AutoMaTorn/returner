diff --git a/cmd/credentials.go b/cmd/credentials.go
new file mode 100644
index 0000000..b355699
--- /dev/null
+++ b/cmd/credentials.go
@@ -0,0 +1,47 @@
+package cmd
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+)
+
+// maxCredentialsSize bounds the single line accepted by "--credentials-stdin".
+const maxCredentialsSize = 64 * 1024
+
+// StateDirectoryEnvName overrides the session storage location without migrating legacy state.
+const StateDirectoryEnvName = "IPATOOL_STATE_DIR"
+
+// stdinCredentials holds secrets supplied on stdin, keeping them out of the process arguments.
+type stdinCredentials struct {
+	KeychainPassphrase string `json:"keychain-passphrase"`
+	Password           string `json:"password"`
+	AuthCode           string `json:"auth-code"`
+}
+
+var credentials stdinCredentials
+
+// readStdinCredentials parses a single JSON line of credentials.
+func readStdinCredentials(input io.Reader) (stdinCredentials, error) {
+	var result stdinCredentials
+
+	line, err := bufio.NewReader(io.LimitReader(input, maxCredentialsSize)).ReadString('\n')
+	if err != nil && !errors.Is(err, io.EOF) {
+		return result, fmt.Errorf("failed to read credentials: %w", err)
+	}
+
+	line = strings.TrimSpace(line)
+	if line == "" {
+		return result, errors.New("credentials are required on stdin when using the \"--credentials-stdin\" flag")
+	}
+
+	// The decoder error is dropped on purpose: it can echo fragments of the input.
+	if json.Unmarshal([]byte(line), &result) != nil {
+		return result, errors.New("credentials on stdin must be a single JSON object")
+	}
+
+	return result, nil
+}
diff --git a/cmd/credentials_test.go b/cmd/credentials_test.go
new file mode 100644
index 0000000..09688b5
--- /dev/null
+++ b/cmd/credentials_test.go
@@ -0,0 +1,39 @@
+package cmd
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestReadStdinCredentials(t *testing.T) {
+	got, err := readStdinCredentials(strings.NewReader(
+		`{"keychain-passphrase":"k","password":"p w\"d","auth-code":"123456"}` + "\r\n" + "ignored",
+	))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if got.KeychainPassphrase != "k" || got.Password != `p w"d` || got.AuthCode != "123456" {
+		t.Fatalf("unexpected credentials: %+v", got)
+	}
+}
+
+func TestReadStdinCredentialsWithoutNewline(t *testing.T) {
+	got, err := readStdinCredentials(strings.NewReader(`{"keychain-passphrase":"k"}`))
+	if err != nil || got.KeychainPassphrase != "k" || got.Password != "" {
+		t.Fatalf("unexpected result: %+v, %v", got, err)
+	}
+}
+
+func TestReadStdinCredentialsRejectsBadInput(t *testing.T) {
+	for _, input := range []string{"", "\n", "secret-not-json\n"} {
+		_, err := readStdinCredentials(strings.NewReader(input))
+		if err == nil {
+			t.Fatalf("expected an error for %q", input)
+		}
+
+		if strings.Contains(err.Error(), "secret") {
+			t.Fatalf("error leaks input: %v", err)
+		}
+	}
+}
