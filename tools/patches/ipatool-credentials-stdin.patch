new file mode 100644
index 0000000..fb297aa
--- /dev/null
+++ b/pkg/appstore/apple_message.go
@@ -0,0 +1,20 @@
+package appstore
+
+// AppleMessageError marks an error whose text Apple wrote for the person
+// signing in (a sign-in dialog or a customer message), as opposed to a
+// diagnostic produced by ipatool itself.
+type AppleMessageError struct {
+	err error
+}
+
+func newAppleMessageError(err error) *AppleMessageError {
+	return &AppleMessageError{err: err}
+}
+
+func (e *AppleMessageError) Error() string {
+	return e.err.Error()
+}
+
+func (e *AppleMessageError) Unwrap() error {
+	return e.err
+}
diff --git a/pkg/appstore/apple_message_test.go b/pkg/appstore/apple_message_test.go
new file mode 100644
index 0000000..150e426
--- /dev/null
+++ b/pkg/appstore/apple_message_test.go
@@ -0,0 +1,60 @@
+package appstore
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/majd/ipatool/v2/pkg/http"
+)
+
+func TestLoginAppleTextIsMarked(t *testing.T) {
+	cases := map[string]loginResult{
+		"dialog": {
+			Dialog: loginDialogResult{
+				Message:     "This Apple Account has been locked for security reasons.",
+				Explanation: "Reset your password to continue.",
+			},
+		},
+		"customer message": {
+			FailureType:     "-5000",
+			CustomerMessage: "Your account cannot be used right now.",
+		},
+	}
+
+	for name, data := range cases {
+		t.Run(name, func(t *testing.T) {
+			res := &http.Result[loginResult]{StatusCode: 200, Data: data}
+
+			_, _, err := (&appstore{}).parseLoginResponse(res, 2, "", "https://example.com")
+
+			var apple *AppleMessageError
+			if !errors.As(err, &apple) {
+				t.Fatalf("expected an Apple message, got %v", err)
+			}
+		})
+	}
+}
+
+func TestLoginOwnErrorsAreNotMarked(t *testing.T) {
+	cases := map[string]loginResult{
+		"account disabled":     {CustomerMessage: CustomerMessageAccountDisabled},
+		"failure without text": {FailureType: "-5000"},
+		"empty answer":         {},
+	}
+
+	for name, data := range cases {
+		t.Run(name, func(t *testing.T) {
+			res := &http.Result[loginResult]{StatusCode: 200, Data: data}
+
+			_, _, err := (&appstore{}).parseLoginResponse(res, 2, "", "https://example.com")
+			if err == nil {
+				t.Fatal("expected an error")
+			}
+
+			var apple *AppleMessageError
+			if errors.As(err, &apple) {
+				t.Fatalf("did not expect an Apple message: %v", err)
+			}
+		})
+	}
+}
