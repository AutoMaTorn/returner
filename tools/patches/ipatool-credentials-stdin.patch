diff --git a/internal/sap/assets/zip_whole.go b/internal/sap/assets/zip_whole.go
new file mode 100644
index 0000000..b86b02f
--- /dev/null
+++ b/internal/sap/assets/zip_whole.go
@@ -0,0 +1,51 @@
+package assets
+
+import (
+	"archive/zip"
+	"bytes"
+	"compress/flate"
+	"errors"
+	"fmt"
+	"hash/crc32"
+	"io"
+)
+
+// readWholeEntry reads a stored or deflated archive member with a single
+// ReadAt on the archive and inflates it in memory. Through entry.Open the
+// inflater pulls a remote image in 4 KiB reads, one HTTP range request each,
+// which for the 33 MB kernel collection takes minutes on a typical line.
+func readWholeEntry(entry *zip.File, limit int64) ([]byte, error) {
+	raw, err := entry.OpenRaw()
+	if err != nil {
+		return nil, fmt.Errorf("open raw member: %w", err)
+	}
+
+	compressed := make([]byte, entry.CompressedSize64)
+	if _, err := io.ReadFull(raw, compressed); err != nil {
+		return nil, fmt.Errorf("read member: %w", err)
+	}
+
+	var reader io.Reader = bytes.NewReader(compressed)
+
+	switch entry.Method {
+	case zip.Store:
+	case zip.Deflate:
+		inflater := flate.NewReader(reader)
+		defer inflater.Close()
+
+		reader = inflater
+	default:
+		return nil, fmt.Errorf("unsupported member compression method %d", entry.Method)
+	}
+
+	data, err := io.ReadAll(io.LimitReader(reader, limit+1))
+	if err != nil {
+		return nil, fmt.Errorf("inflate member: %w", err)
+	}
+
+	if int64(len(data)) <= limit && crc32.ChecksumIEEE(data) != entry.CRC32 {
+		return nil, errors.New("member failed its CRC-32 check")
+	}
+
+	return data, nil
+}
diff --git a/internal/sap/assets/zip_whole_test.go b/internal/sap/assets/zip_whole_test.go
new file mode 100644
index 0000000..58ee558
--- /dev/null
+++ b/internal/sap/assets/zip_whole_test.go
@@ -0,0 +1,92 @@
+package assets
+
+import (
+	"archive/zip"
+	"bytes"
+	"crypto/rand"
+	"testing"
+)
+
+// countingReaderAt records how many reads reach the archive, standing in
+// for HTTP range requests against the remote restore image.
+type countingReaderAt struct {
+	data  []byte
+	reads int
+}
+
+func (c *countingReaderAt) ReadAt(p []byte, off int64) (int, error) {
+	c.reads++
+
+	return bytes.NewReader(c.data).ReadAt(p, off)
+}
+
+func archiveWith(t *testing.T, method uint16, payload []byte) []byte {
+	t.Helper()
+
+	var buffer bytes.Buffer
+
+	writer := zip.NewWriter(&buffer)
+
+	member, err := writer.CreateHeader(&zip.FileHeader{Name: "member", Method: method})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := member.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	return buffer.Bytes()
+}
+
+func TestReadWholeEntryReadsTheDataAtOnce(t *testing.T) {
+	payload := make([]byte, 2<<20)
+	if _, err := rand.Read(payload[:len(payload)/2]); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, method := range []uint16{zip.Store, zip.Deflate} {
+		source := &countingReaderAt{data: archiveWith(t, method, payload)}
+
+		archive, err := zip.NewReader(source, int64(len(source.data)))
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		entry := archive.File[0]
+		before := source.reads
+
+		data, err := readWholeEntry(entry, int64(len(payload)))
+		if err != nil {
+			t.Fatalf("method %d: %v", method, err)
+		}
+
+		if !bytes.Equal(data, payload) {
+			t.Fatalf("method %d: payload differs", method)
+		}
+
+		// The member's local header, then all of its data at once.
+		if reads := source.reads - before; reads != 2 {
+			t.Fatalf("method %d: %d reads of the archive, want 2", method, reads)
+		}
+	}
+}
+
+func TestReadWholeEntryRejectsACorruptMember(t *testing.T) {
+	payload := bytes.Repeat([]byte("kernel"), 1000)
+	data := archiveWith(t, zip.Store, payload)
+	data[bytes.Index(data, payload)] ^= 0xff
+
+	archive, err := zip.NewReader(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := readWholeEntry(archive.File[0], int64(len(payload))); err == nil {
+		t.Fatal("a member with a wrong CRC-32 was accepted")
+	}
+}
diff --git a/internal/sap/unicorn/prepare.go b/internal/sap/unicorn/prepare.go
new file mode 100644
index 0000000..da73343
--- /dev/null
+++ b/internal/sap/unicorn/prepare.go
@@ -0,0 +1,83 @@
+//go:build !ios
+
+package unicorn
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"runtime"
+)
+
+// Cached reports whether the Unicorn runtime for this platform is already in
+// the user cache and intact. It never touches the network.
+func Cached() bool {
+	goos := runtime.GOOS
+	if goos == "linux" && linuxUsesMusl() {
+		goos = "linux-musl"
+	}
+
+	selected, err := artifactFor(goos, runtime.GOARCH)
+	if err != nil {
+		return false
+	}
+
+	cache, err := os.UserCacheDir()
+	if err != nil {
+		return false
+	}
+
+	root := filepath.Join(cache, "ipatool", "unicorn", unicornVersion)
+	for _, item := range append(append([]artifact{}, selected.dependencies...), selected) {
+		path := filepath.Join(root, item.librarySHA256, item.filename)
+		if ok, _ := fileMatchesSHA256(path, item.librarySHA256); !ok {
+			return false
+		}
+	}
+
+	return true
+}
+
+// archiveSizes are the byte sizes of the pinned archives, keyed by their
+// SHA-256, as the servers reported them on 2026-11-12. They only feed the
+// progress estimate; the checksum still decides whether a download is good.
+var archiveSizes = map[string]int64{
+	"2a6f738fab5fabffa56af1e7bbf16ea1e91466c342f8dc64f125bd70f36c6b80": 12958220,
+	"d6c93e0f60328d8f4a1792af3f834137a28050fcc2305f2ec01efe8558a9844e": 12142730,
+	"9d6e6dea140560de4ebd8446661f7ef84a357d428c14a3ef09dacd306ec8c239": 16436886,
+	"bd1fb0c9af5f57e356d8a96928b4fe045b2e18f308ef23b481d5f970008aa722": 15372569,
